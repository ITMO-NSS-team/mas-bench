# LLM access used by the systems under test and the LLM-as-a-judge
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# AutoMAS routes through OpenRouter explicitly. If OPENAI_BASE_URL already
# points at OpenRouter, OPENAI_API_KEY is reused automatically; otherwise set
# this separately.
# OPENROUTER_API_KEY=

# Shared web-search backend for both systems (`just searxng-start`). Both
# AutoMAS' searxng MCP server and SwarmAgentic's web_search shim default to
# port 8888, but the bundled instance listens on 18888 -- set this explicitly
# or web search silently fails with a connection error.
SEARXNG_URL=http://localhost:18888

# Model for the LLM-as-a-judge (llm_accuracy metric). Kept independent of the
# system-under-test backbone (--model) so scoring stays consistent across runs.
# Default: openai/gpt-4o-mini
# JUDGE_MODEL=openai/gpt-4o-mini

# Disable pydantic plugins: the installed logfire (a pydantic entry-point plugin)
# imports a symbol removed in opentelemetry-sdk 1.41, spamming a harmless
# ImportError UserWarning on every pydantic-ai agent run. We don't use logfire.
PYDANTIC_DISABLE_PLUGINS=1

# --- Library settings ---
# BENCHLIB_LOG_LEVEL=INFO
